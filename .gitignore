# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.so

# Virtual environment
venv/
venv
env/
.venv/
.env/

# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Database files
*.sqlite3
*.db
*.dump

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

