.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (frontend)
node_modules/
npm-debug.log*
yarn-error.log*

# Compiled
*.pyc
*.class

# Temporary
*.tmp
*.bak
*.orig
*.bak.*

# Generated KB artifacts (produced by scripts/sync_knowledge_base_to_runtime.py)
resources/generated_kb/

# Generated report output (private contact/employee data).
# Root-anchored deliberately: the unanchored `reports/` form also matched
# modules/reports/ — the source package imported by app/main.py,
# modules/admin_commands and modules/scheduler — which meant that code was
# never committed and a clean checkout could not import the app at all.
/reports/

# Local infra / GitHub Models integration
github-models/

# Internal audit / planning documents
audit-*.md
consolidation-plan*.md
RECRUITMENT_BOT_COORDINATION.md

# Internal business documentation and production-derived data
/docs/
/knowledge_base/
/audits/
/audit-report/
/HERMES_ADMIN_BRIDGE_HANDOFF_2026/
/resources/ops/
/resources/_internal_archived/
/tests/unit/data/recruitment_regression_corpus/
/SYSTEM_ATLAS.md
/BUSINESS-CONSTITUTION.md
/MASTER_PLAN_KNOWLEDGE_BASE_BRAIN.md
/db/MIGRATION_INVENTORY.md
/scripts/import_missing_advance_transactions.py
/scripts/recover_critical_numbers.py
/app/static/assets/company-logo.png

# Exclude internal root documents unless they are sanitized public guides
/*.md
!/README.md
!/MASTER_PRODUCTION_PLAN.md

# Exclude private operational resources and local runtime state
/.claude/
/.kilo/
/archive/
/store/
/resources/*
!/resources/csv_templates/
!/resources/csv_templates/**
/db/.env_flags_acknowledged
/AUDIT_SUMMARY.json
/recover_critical_numbers.py
/recover_from_backup.py
# No rule for fazle-core.service: that file in the repo root is the unit
# TEMPLATE (source). install.sh renders it to a temp file and installs the
# result to /etc/systemd/system — nothing generated ever lands here.
/fazle-social-auto-reply.service

# Exclude internal Markdown except the sanitized public guides
**/*.md
!README.md
!MASTER_PRODUCTION_PLAN.md

# Keep one generic scanner; other scripts are operational or data-specific
/scripts/*
!/scripts/secret_scan.sh
# The restart gate is neither: it is covered by unit tests and run by
# install.sh, so it must ship with the code.
!/scripts/restart_gate_readiness.py
# The schema builder is a build artefact of the installer, not an ad-hoc
# operational script: install.sh calls it, so it MUST be tracked. It was
# silently swallowed by /scripts/* once already, and the merged tree shipped an
# installer that died on a missing file.
!/scripts/apply_schema.py
# Operational checks referenced by install.sh / the Makefile / the README.
# Anything an operator is told to run belongs in git — see the /scripts/*
# incident in README "Operational readiness audit".
!/scripts/verify_isolation.py
!/scripts/restore_drill.py
!/scripts/bridge_smoke.py
!/scripts/rbac_write_audit.py

# Backup files
backups/
cleanup-log*.txt
cleanup-post-state.json

# Runtime lock for the canonical Recruitment authority register. Keep this
# exact-path rule narrow: other lock/runtime artifacts must remain visible.
/knowledge_base/00_governance/recruitment_fact_authority.json.lock
moonshot_test.py
