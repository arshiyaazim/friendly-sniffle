# Required application database
DATABASE_URL=postgresql://fazle_app:replace-me@localhost:5432/fazle_core

# Core service settings
INTERNAL_API_KEY=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379/9
APP_PORT=8200
AUTO_REPLY_ENABLED=false

# WhatsApp bridge endpoints and identifiers
BRIDGE1_URL=http://localhost:8082
BRIDGE1_NUMBER=
BRIDGE1_LABEL=HR
BRIDGE2_URL=http://localhost:8081
BRIDGE2_NUMBER=
BRIDGE2_LABEL=OPS
BRIDGE3_URL=http://localhost:8083
BRIDGE3_NUMBER=
BRIDGE3_LABEL=REC2
BRIDGE1_DB_PATH=store/bridge1/messages.db
BRIDGE2_DB_PATH=store/bridge2/messages.db
BRIDGE3_DB_PATH=store/bridge3/messages.db

# Local AI provider
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hermes3:3b
PRIMARY_AI_PROVIDER=ollama

# Optional external AI providers (configure only providers you use)
GITHUB_TOKEN=
GITHUB_MODEL_NAME=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL_NAME=allam-2-7b
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
NINE_ROUTER_URL=http://127.0.0.1:20129/v1

# Public company contact links and operational contacts
OFFICE_CONTACT_NUMBERS=
COMPANY_CONTACT_EMAIL=
COMPANY_FACEBOOK_URL=
COMPANY_INSTAGRAM_URL=
ACCOUNTANT_PHONE=
ADMIN_WHATSAPP=
ADMIN_NUMBERS=
ESCORT_CLIENT_PHONES=

# Runtime file locations; use absolute paths on the deployment host
RESOURCES_DIR=./resources
BACKUP_DIR=./backups
ESCORT_HISTORY_IMPORT_FILE=
ESCORT_HISTORY_EXPORT_DIR=
ESCORT_HISTORY_EXPORT_PATTERN=wa_conversation_*.txt
ESCORT_HISTORY_SENDER_PHONE=

